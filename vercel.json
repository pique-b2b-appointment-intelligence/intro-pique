{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pagina/:path*",
      "destination": "/api/t?p=:path*&c=mail"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "onlinegoedgevonden.intro-pique.agency" }],
      "destination": "/onlinegoedgevonden/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "wegmetexcel.intro-pique.agency" }],
      "destination": "/wegmetexcel/:path*"
    }
  ]
}
