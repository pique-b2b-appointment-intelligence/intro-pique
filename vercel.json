{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lightr.intro-pique.agency"
        }
      ],
      "destination": "/aanpoters"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "evenkennismaken.nl"
        }
      ],
      "destination": "https://lightr.nl"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.evenkennismaken.nl"
        }
      ],
      "destination": "https://lightr.nl"
    }
  ],
  "rewrites": [
    {
      "source": "/pagina/:path*",
      "destination": "/api/t?p=:path*&c=mail"
    },
    {
      "source": "/pique/synsel/marco",
      "destination": "/pique/synsel-marco"
    },
    {
      "source": "/pique/synsel/peter-jan",
      "destination": "/pique/synsel-peter-jan"
    },
    {
      "source": "/pique/synsel/:pad*",
      "destination": "/pique/:pad*"
    },
    {
      "source": "/pique/uitmetkorting/arthur",
      "destination": "/pique/uitmetkorting-arthur"
    },
    {
      "source": "/pique/uitmetkorting/vincent",
      "destination": "/pique/uitmetkorting-vincent"
    },
    {
      "source": "/pique/uitmetkorting/:pad*",
      "destination": "/pique/:pad*"
    },
    {
      "source": "/pique/odido/herman",
      "destination": "/pique/odido-herman"
    },
    {
      "source": "/pique/odido/:pad*",
      "destination": "/pique/:pad*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "onlinegoedgevonden.intro-pique.agency"
        }
      ],
      "destination": "/onlinegoedgevonden/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wegmetexcel.intro-pique.agency"
        }
      ],
      "destination": "/wegmetexcel/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lightr.intro-pique.agency"
        }
      ],
      "destination": "/lightr/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vollegym.intro-pique.agency"
        }
      ],
      "destination": "/vollegym/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "evenkennismaken.nl"
        }
      ],
      "destination": "/lightr/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.evenkennismaken.nl"
        }
      ],
      "destination": "/lightr/:path*"
    }
  ]
}
