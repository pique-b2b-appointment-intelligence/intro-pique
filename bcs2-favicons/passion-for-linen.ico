/nl/hoe-linnen-wordt-gemaakt/","size":"default","target":"_self","theme":"default"},"buttonPosition":"!undefined","figure":{"aspectRatioHorizontal":"!undefined","aspectRatioVertical":"!undefined","background":false,"blend":false,"rounded":true,"imageLayout":{"imageFit":"cover","imagePosition":"center"},"imageAltText":"!undefined","imageSources":[{"url":"https://www.passionforlinen.com/uploads/images/medium_op_tekstpagina_hoe_wordt_linnen_gemaakt_2_7b184bd186.jpeg","width":768,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/small_op_tekstpagina_hoe_wordt_linnen_gemaakt_2_7b184bd186.jpeg","width":640,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/thumbnail_op_tekstpagina_hoe_wordt_linnen_gemaakt_2_7b184bd186.jpeg","width":234,"density":"!undefined"}],"imageUrl":"https://www.passionforlinen.com/uploads/images/op_tekstpagina_hoe_wordt_linnen_gemaakt_2_7b184bd186.jpeg","imageMimeType":"image/jpeg"},"video":{"imageAltText":"!undefined","imageSources":[],"imageUrl":"!undefined","imageMimeType":"!undefined"}},{"title":"!undefined","text":"!undefined","button":{"title":null,"href":"/nl/Voordelen-linnen/","size":"default","target":"_self","theme":"default"},"buttonPosition":"!undefined","figure":{"aspectRatioHorizontal":"!undefined","aspectRatioVertical":"!undefined","background":false,"blend":false,"rounded":true,"imageLayout":{"imageFit":"cover","imagePosition":"center"},"imageAltText":"!undefined","imageSources":[{"url":"https://www.passionforlinen.com/uploads/images/medium_voordelen_linnenv_7f89e029dd.jpg","width":768,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/small_voordelen_linnenv_7f89e029dd.jpg","width":640,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/thumbnail_voordelen_linnenv_7f89e029dd.jpg","width":234,"density":"!undefined"}],"imageUrl":"https://www.passionforlinen.com/uploads/images/voordelen_linnenv_7f89e029dd.jpg","imageMimeType":"image/jpeg"},"video":{"imageAltText":"!undefined","imageSources":[],"imageUrl":"!undefined","imageMimeType":"!undefined"}}]}},{"key":"intro","data":{"banner":{"aspectRatioHorizontal":1,"aspectRatioVertical":1,"background":true,"blend":false,"rounded":true,"imageLayout":{"imageFit":"cover","imagePosition":"right"},"imageAltText":"!undefined","imageSources":[{"url":"https://www.passionforlinen.com/uploads/images/xxlarge_foto_bij_tekst_over_PFL_5dc52859a2.jpg","width":1867,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/xlarge_foto_bij_tekst_over_PFL_5dc52859a2.jpg","width":1280,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/large_foto_bij_tekst_over_PFL_5dc52859a2.jpg","width":853,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/medium_foto_bij_tekst_over_PFL_5dc52859a2.jpg","width":512,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/small_foto_bij_tekst_over_PFL_5dc52859a2.jpg","width":427,"density":"!undefined"},{"url":"https://www.passionforlinen.com/uploads/images/thumbnail_foto_bij_tekst_over_PFL_5dc52859a2.jpg","width":104,"density":"!undefined"}],"imageUrl":"https://www.passionforlinen.com/uploads/images/foto_bij_tekst_over_PFL_5dc52859a2.jpg","imageMimeType":"image/jpeg"},"componentTheme":{"backgroundColor":"!undefined","fontFaceText":"!undefined","fontFaceTitle":"!undefined","linkColor":"!undefined","linkHoverColor":"!undefined","textColor":"!undefined","title":"!undefined","titleColor":"!undefined","borderColor":"!undefined","borderHoverColor":"!undefined"},"content":"!undefined","html":"\u003ch4>\u003cspan class=\"text-small\">\u003cstrong>Over Passion for Linen\u003c/strong>\u003c/span>\u003c/h4>\u003cp>&nbsp;\u003c/p>\u003cp>Ik geloof dat thuis een plek moet zijn waar het leven even vertraagt.\u003c/p>\u003cp>Mijn liefde voor linnen begon met de puurheid ervan – een natuurlijke stof die ademt, met de tijd steeds zachter wordt en met elk gebruik mooier wordt. Ik werd aangetrokken door de stille kracht en moeiteloze elegantie ervan. Vanuit dat gevoel ontstond Passion for Linen, inmiddels meer dan 15 jaar geleden.\u003c/p>\u003cp>In plaats van trends te volgen, richt ik me op het creëren van tijdloze essentials voor bed, bad en huis – stukken die natuurlijk, rustig en prettig aanvoelen om mee te leven. Elke collectie wordt ontworpen in Nederland en vervaardigd in Portugal, waarbij Europees vakmanschap en de schoonheid van eenvoud worden geëerd.\u003c/p>\u003cp>Voor mij gaat echte luxe niet over overdaad of perfectie. Het gaat over comfort, zachtheid en ruimtes die je laten uitademen.\u003c/p>\u003cp>Dank je wel dat je hier bent en kiest voor een zachtere manier van leven.\u003c/p>\u003cp>Liefs,\u003cbr>Barbara\u003c/p>","reverse":false}},{"key":"content","data":{"backgroundColor":"!undefined","componentTheme":{"backgroundColor":"#ffffff","fontFaceText":"sans","fontFaceTitle":"sans","linkColor":"!undefined","linkHoverColor":"!undefined","textColor":"!undefined","title":"Header Brand Bar","titleColor":"!undefined","borderColor":"#000000","borderHoverColor":"!undefined"},"html":"\u003cp>\u003cstrong>Leveringen buiten Europa\u003c/strong>\u003cbr>Voor verzendingen buiten Europa verzoeken wij u vriendelijk contact met ons op te nemen via \u003ca href=\"mailto:info@passionforlinen.com\">\u003cstrong>info@passionforlinen.com\u003c/strong>\u003c/a> voor een persoonlijke verzendofferte.\u003c/p>"}}],"preloadLinks":["https://www.passionforlinen.com/uploads/images/Dekbedovertrekken_682c66d000.jpg","https://www.passionforlinen.com/uploads/images/sierkussens_74fde51ff8.jpg","https://www.passionforlinen.com/uploads/images/Lakens_e171f4dc60.jpg","https://www.passionforlinen.com/uploads/images/plaids_c35985c3e0.jpg","https://www.passionforlinen.com/uploads/images/kussenslopen_2b3085ddb6.jpg","https://www.passionforlinen.com/uploads/images/antibes_sfeer_1_c759ecfd3c.jpg","https://www.passionforlinen.com/uploads/images/materiaaleigenschappen_f3dd16032f.jpg","https://www.passionforlinen.com/uploads/images/op_tekstpagina_hoe_wordt_linnen_gemaakt_2_7b184bd186.jpeg","https://www.passionforlinen.com/uploads/images/voordelen_linnenv_7f89e029dd.jpg"],"instantloadAmount":3},"_pageContextInitIsPassedToClient":true}</script>
