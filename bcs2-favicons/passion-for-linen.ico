_tekst_over_PFL_5dc52859a2.jpg","hash":"large_foto_bij_tekst_over_PFL_5dc52859a2","mime":"image/jpeg","name":"large_foto bij tekst over PFL.jpg","path":null,"size":147.53,"width":853,"height":1280,"sizeInBytes":147530},"small":{"ext":".jpg","url":"https://www.passionforlinen.com/uploads/images/small_foto_bij_tekst_over_PFL_5dc52859a2.jpg","hash":"small_foto_bij_tekst_over_PFL_5dc52859a2","mime":"image/jpeg","name":"small_foto bij tekst over PFL.jpg","path":null,"size":45.42,"width":427,"height":640,"sizeInBytes":45418},"medium":{"ext":".jpg","url":"https://www.passionforlinen.com/uploads/images/medium_foto_bij_tekst_over_PFL_5dc52859a2.jpg","hash":"medium_foto_bij_tekst_over_PFL_5dc52859a2","mime":"image/jpeg","name":"medium_foto bij tekst over PFL.jpg","path":null,"size":62.74,"width":512,"height":768,"sizeInBytes":62742},"xlarge":{"ext":".jpg","url":"https://www.passionforlinen.com/uploads/images/xlarge_foto_bij_tekst_over_PFL_5dc52859a2.jpg","hash":"xlarge_foto_bij_tekst_over_PFL_5dc52859a2","mime":"image/jpeg","name":"xlarge_foto bij tekst over PFL.jpg","path":null,"size":314.01,"width":1280,"height":1920,"sizeInBytes":314008},"xxlarge":{"ext":".jpg","url":"https://www.passionforlinen.com/uploads/images/xxlarge_foto_bij_tekst_over_PFL_5dc52859a2.jpg","hash":"xxlarge_foto_bij_tekst_over_PFL_5dc52859a2","mime":"image/jpeg","name":"xxlarge_foto bij tekst over PFL.jpg","path":null,"size":709.47,"width":1867,"height":2800,"sizeInBytes":709469},"thumbnail":{"ext":".jpg","url":"https://www.passionforlinen.com/uploads/images/thumbnail_foto_bij_tekst_over_PFL_5dc52859a2.jpg","hash":"thumbnail_foto_bij_tekst_over_PFL_5dc52859a2","mime":"image/jpeg","name":"thumbnail_foto bij tekst over PFL.jpg","path":null,"size":3.82,"width":104,"height":156,"sizeInBytes":3818}},"alternativeText":null,"__typename":"UploadFile"},"__typename":"UploadFileEntity"},"__typename":"UploadFileEntityResponse"},"aspectRatioVertical":1,"aspectRatioHorizontal":1,"rounded":true,"background":true,"blend":false,"imageLayout":{"imageFit":"cover","imagePosition":"right","__typename":"ComponentSharedImageLayout"},"__typename":"ComponentSharedFigure"},"reverse":false,"componentTheme":{"data":null,"__typename":"ComponentThemeEntityResponse"},"html":"\u003ch4>\u003cspan class=\"text-small\">\u003cstrong>Over Passion for Linen\u003c/strong>\u003c/span>\u003c/h4>\u003cp>&nbsp;\u003c/p>\u003cp>Ik geloof dat thuis een plek moet zijn waar het leven even vertraagt.\u003c/p>\u003cp>Mijn liefde voor linnen begon met de puurheid ervan – een natuurlijke stof die ademt, met de tijd steeds zachter wordt en met elk gebruik mooier wordt. Ik werd aangetrokken door de stille kracht en moeiteloze elegantie ervan. Vanuit dat gevoel ontstond Passion for Linen, inmiddels meer dan 15 jaar geleden.\u003c/p>\u003cp>In plaats van trends te volgen, richt ik me op het creëren van tijdloze essentials voor bed, bad en huis – stukken die natuurlijk, rustig en prettig aanvoelen om mee te leven. Elke collectie wordt ontworpen in Nederland en vervaardigd in Portugal, waarbij Europees vakmanschap en de schoonheid van eenvoud worden geëerd.\u003c/p>\u003cp>Voor mij gaat echte luxe niet over overdaad of perfectie. Het gaat over comfort, zachtheid en ruimtes die je laten uitademen.\u003c/p>\u003cp>Dank je wel dat je hier bent en kiest voor een zachtere manier van leven.\u003c/p>\u003cp>Liefs,\u003cbr>Barbara\u003c/p>","__typename":"ComponentComponentIntro"},{"id":"86","html":"\u003cp>\u003cstrong>Leveringen buiten Europa\u003c/strong>\u003cbr>Voor verzendingen buiten Europa verzoeken wij u vriendelijk contact met ons op te nemen via \u003ca href=\"mailto:info@passionforlinen.com\">\u003cstrong>info@passionforlinen.com\u003c/strong>\u003c/a> voor een persoonlijke verzendofferte.\u003c/p>","componentTheme":{"data":{"attributes":{"title":"Header Brand Bar","backgroundColor":"#ffffff","textColor":null,"linkColor":null,"linkHoverColor":null,"titleColor":null,"fontFaceTitle":"sans","fontFaceText":"sans","borderColor":"#000000","borderHoverColor":null,"__typename":"ComponentTheme"},"__typename":"ComponentThemeEntity"},"__typename":"ComponentThemeEntityResponse"},"__typename":"ComponentComponentContent"}],"seo":{"metaTitle":"Passion for Linen | big assortment","metaDescription":"High Quality Linen in many rustic styles and colors. Quality and for every size bed.","metaImage":{"data":null,"__typename":"UploadFileEntityResponse"},"metaSocial":[],"meta":[],"structuredData":null,"noIndex":false,"noFollow":false,"canonicalURL":null,"__typename":"ComponentSharedSeo"},"__typename":"Homepage"},"dynamicZone":[{"key":"content","data":{"backgroundColor":"!undefined","componentTheme":{"backgroundColor":"#ffffff","fontFaceText":"sans","fontFaceTitle":"sans","linkColor":"!undefined","linkHoverColor":"!undefined","textColor":"!undefined","title":"Header Brand Bar","titleColor":"!undefined","borderColor":"#000000","borderHoverColor":"!undefined"},"html":"\u003cp style=\"text-align:center;\">\u003cstrong>In a world that moves fast, your home shouldn’t\u003c/strong>\u003c/p>\u003cp style=\"text-align:center;\">Tijdloze linnen essentials voor bed, bad en interieur — ontworpen om zachtheid en eenvoud terug te brengen in het dagelijks leven.\u003c/p>\u003cp style=\"text-align:center;\">Gemaakt van Europees vlas, geproduceerd in Portugal en ontworpen in Nederland, met aandacht voor textuur, balans en comfort.\u003c/p>"}},{"key":"images","data":{"componentTheme":{"backgroundColor":"#ffffff","fontFaceText":"sans","fontFaceTitle":"sans","linkColor":"!undefined","linkHoverColor":"!undefined","textColor":"!undefined","title":"Header Brand Bar","titleColor":"!undefined","borderColor":"#000000","borderHoverColor":"!undefined"},"backgroundColor":"!undefined","container":true,"items":[{"button":{"title":"Dekbedovertrekken","href":"/nl/products/alle/dekbedovertrekken/","target":"_self"},"buttonTheme":"text","figure":{"aspectRatioHorizontal":"!undefined","aspectRatioVertical":"!undefined","background":fals